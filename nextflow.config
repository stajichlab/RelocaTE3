/*
 * RelocaTE3 Nextflow pipeline: parameters, profiles, manifest.
 *
 * Every process runs one `relocaTE3` subcommand with the arguments `run-all`
 * passes (src/RelocaTE3/cli.py cmd_run_all). Calling defaults equal run-all's
 * argparse defaults; tests/nextflow_schema_test.py keeps them, the schema and
 * the aligner choices in sync.
 */

params {
    // Input / output
    input = null
    genome = null
    te_library = null
    repeatmasker = null
    outdir = null

    // Calling (same names and defaults as `relocaTE3 run-all`)
    te_aligner = 'blat'
    genome_aligner = 'bwaaln'
    te_opts = ''
    genome_opts = ''
    mismatch = 2
    min_match = 10
    min_trimmed = 10
    size = 500
    min_mapq = 0
    tsd = 'UNK'
    require_both_junctions = true
    target = 'ALL'
    te_name = 'repeat'
    distance = 3

    // Genotyping: on by default here; opt-in (--genotype) for run-all
    genotype = true
    excision = false
    bcftools = 'bcftools'

    // `pixi` profile: environment whose bin/ holds relocaTE3 and the aligners
    pixi_env = "${projectDir}/.pixi/envs/blat"

    // Container profiles (docker, apptainer, singularity): the image is
    // <container_registry>:<container_tag>, published by
    // .github/workflows/container.yml as dev (main), pr-<n>, sha-<short> and
    // <version> (v* tags). A development manifest has no image of its own, so
    // the default is `dev`; a release sets it to the manifest version
    // (tests/nextflow_schema_test.py). Pin a run with e.g.
    // --container_tag 0.3.0 or sha-<short>.
    container_registry = 'ghcr.io/stajichlab/relocate3'
    container_tag = 'dev'
}

manifest {
    name = 'stajichlab/RelocaTE3'
    description = 'Transposable element insertion detection from resequencing data'
    homePage = 'https://github.com/stajichlab/RelocaTE3'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version = '0.3.0dev'
}

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Nextflow run reports. Fixed names, overwritten on rerun. Nextflow opens
// these files before parameter validation, so they are off without --outdir
// (validation then fails on the missing outdir) instead of going to ./null/.
timeline {
    enabled = params.outdir ? true : false
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = params.outdir ? true : false
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = params.outdir ? true : false
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = params.outdir ? true : false
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

/*
 * Software profiles: exactly one of pixi, docker, apptainer, singularity.
 * pixi runs tasks on the host with the blat env first on PATH (no container).
 * The container profiles run every task in the image; command-line
 * --container_tag / --container_registry reach process.container (CLI params
 * are set before this file is read; tests/nextflow_profiles_test.py).
 */
profiles {
    pixi {
        process.beforeScript = "export PATH=${params.pixi_env}/bin:\$PATH"
    }
    docker {
        process.container = "${params.container_registry}:${params.container_tag}"
        docker.enabled = true
        // Output files owned by the user, not root.
        docker.runOptions = '-u $(id -u):$(id -g)'
        apptainer.enabled = false
        singularity.enabled = false
    }
    // Remote images go to NXF_APPTAINER_CACHEDIR (read by Nextflow itself;
    // a cacheDir here would override it), else <workDir>/apptainer. Set it to
    // a shared directory so runs reuse one pull. pullTimeout: the image is
    // ~1.1 GB unpacked and the SIF conversion is slow; the default is 20 min.
    apptainer {
        process.container = "${params.container_registry}:${params.container_tag}"
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.pullTimeout = '60 min'
        docker.enabled = false
        singularity.enabled = false
    }
    // As apptainer; the cache env var is NXF_SINGULARITY_CACHEDIR.
    singularity {
        process.container = "${params.container_registry}:${params.container_tag}"
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.pullTimeout = '60 min'
        docker.enabled = false
        apptainer.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}
