/*
 * RelocaTE3 Nextflow pipeline: parameters, profiles, manifest.
 *
 * Every process runs one `relocaTE3` subcommand with the arguments `run-all`
 * passes (src/RelocaTE3/cli.py cmd_run_all). Calling defaults equal run-all's
 * argparse defaults; tests/nextflow_schema_test.py keeps them, the schema and
 * the aligner choices in sync.
 */

params {
    // Input / output
    input = null
    genome = null
    te_library = null
    repeatmasker = null
    outdir = null

    // Calling (same names and defaults as `relocaTE3 run-all`)
    te_aligner = 'blat'
    genome_aligner = 'bwaaln'
    mismatch = 2
    min_match = 10
    min_trimmed = 10
    size = 500
    min_mapq = 0
    tsd = 'UNK'
    require_both_junctions = true
    target = 'ALL'
    te_name = 'repeat'

    // Genotyping: on by default here; opt-in (--genotype) for run-all
    genotype = true

    // `pixi` profile: environment whose bin/ holds relocaTE3 and the aligners
    pixi_env = "${projectDir}/.pixi/envs/blat"
}

manifest {
    name = 'stajichlab/RelocaTE3'
    description = 'Transposable element insertion detection from resequencing data'
    homePage = 'https://github.com/stajichlab/RelocaTE3'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version = '0.3.0dev'
}

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
    }
}

includeConfig 'conf/base.config'

profiles {
    pixi {
        process.beforeScript = "export PATH=${params.pixi_env}/bin:\$PATH"
    }
    test {
        includeConfig 'conf/test.config'
    }
}
