config {
    // "." so module tests under modules/local/*/tests/ are found too.
    testsDir "."
    workDir ".nf-test"
    // results/ can hold full repo clones (validation/release/fresh_clone_check.slurm)
    // whose own tests must not be collected here; .pixi holds environments.
    ignore "results/**", ".pixi/**", ".nf-test/**"
    // Each test names its profile (e.g. "test,pixi"); no container default.
    profile ""
}
