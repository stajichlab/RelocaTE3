/*
 * UCR HPCC (SLURM). Use with a container profile:
 *
 *   -profile hpcc,apptainer [--slurm_partition intel]
 *
 * Launch pattern: Nextflow itself runs in a small sbatch head job (never on the
 * login node) and submits one SLURM job per task:
 *
 *   #!/usr/bin/bash -l
 *   #SBATCH -p intel --cpus-per-task=2 --mem=8G --time=3-00:00:00
 *   #SBATCH -o logs/nextflow_head.%j.log
 *   export NXF_APPTAINER_CACHEDIR=/bigdata/<lab>/<user>/apptainer-cache
 *   module load apptainer/1.5.3
 *   pixi run -e nf nextflow run . -profile hpcc,apptainer --container_tag <tag> \
 *       --input ... --outdir ... -work-dir /bigdata/... -resume
 *
 * (`module load nextflow/26.04.6` works instead of `pixi run -e nf`.)
 *
 * Image cache: Nextflow pulls the image once, on the head job's node, into
 * NXF_APPTAINER_CACHEDIR (read by Nextflow itself), else into
 * <work-dir>/apptainer, i.e. once per work directory. Point the env var at a
 * shared bigdata directory: home quotas are small and every node must see the
 * SIF. No cacheDir is set here, because a config value would override the env
 * var.
 */

process {
    executor = 'slurm'
    queue = params.slurm_partition
    // intel nodes (sinfo -p intel): 64 CPUs, 450000 MB = 439 GiB, 30 days.
    // Memory stays below the node's 439 GiB, else a capped request never runs.
    resourceLimits = [cpus: 64, memory: 430.GB, time: 30.d]
}

executor {
    $slurm {
        // At most 50 queued/running tasks per pipeline run, submitted at most
        // 10 per minute: well under the per-user limits (MaxSubmit 5000; QOS
        // cpu=256 on intel) and gentle on slurmctld when a 72-sample run
        // starts. Tasks beyond the limits simply wait in Nextflow.
        queueSize = 50
        submitRateLimit = '10/1min'
    }
}
