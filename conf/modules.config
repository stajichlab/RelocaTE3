/*
 * Publishing: each sample's files land in ${params.outdir}/<sample>/ at the
 * same relative paths as `relocaTE3 run-all -o <sample>` writes them.
 *
 * Only declared outputs are published (never staged inputs), and versions.yml
 * is dropped (collected into pipeline_info/software_versions.yml instead).
 * CAT_FASTQ (merged lanes) and RELOCATE3_INDEX_GENOME (genome index) are not
 * published: run-all writes neither into the sample directory. Under BLAT
 * scatter, RELOCATE3_TE_MERGE_TRIM writes RELOCATE3_TE_SEARCH's files and is
 * published like it; the chunks and their BAMs (RELOCATE3_TE_SPLIT,
 * RELOCATE3_TE_SEARCH_CHUNK) are not published.
 * RELOCATE3_COHORT -> ${params.outdir}/cohort/, MULTIQC -> ${params.outdir}/multiqc/.
 */

process {
    withName: 'RELOCATE3_TE_SEARCH|RELOCATE3_TE_MERGE_TRIM|RELOCATE3_ALIGN_GENOME|RELOCATE3_ALIGN_READS|RELOCATE3_FIND_INSERTIONS|RELOCATE3_FIND_REFERENCE|RELOCATE3_CHARACTERIZE' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    // Once per run: the cohort tables and the MultiQC report (with its data
    // dir). RELOCATE3_SAMPLE_STATS is not published: its per-sample rows feed
    // MULTIQC only (merged in multiqc/relocate3_report_data/
    // multiqc_relocate3_sample_stats_table.txt), and nothing may be added to
    // the run-all layout of ${params.outdir}/<sample>/.
    withName: 'RELOCATE3_COHORT' {
        publishDir = [
            path: { "${params.outdir}/cohort" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }
    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }
}
