/*
 * Chr3 2 Mb simulated fixture, the inputs of tests/acceptance_test.py
 * test_run_all_cli_end_to_end. Run from the repository root:
 *
 *   pixi run -e nf nextflow run . -profile test,pixi
 *
 * The sample sheet lists reads relative to the repository root, because
 * nf-schema resolves relative sheet paths against the launch directory.
 */

params {
    input = "${projectDir}/tests/data/samplesheet_chr3.csv"
    genome = "${projectDir}/tests/data/sim_genome/MSU7.Chr3_2M.fa"
    te_library = "${projectDir}/tests/data/TE_lib/RiceTE.fa"
    repeatmasker = "${projectDir}/tests/data/sim_genome/MSU7.Chr3_2M.fa.RepeatMasker.out"
    te_name = 'repeat'
    mismatch = 2
    require_both_junctions = true
    outdir = 'results/nextflow_test'
}

process {
    resourceLimits = [cpus: 4, memory: 8.GB]
}
