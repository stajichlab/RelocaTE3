/*
 * Resource labels. Thread counts follow task.cpus; memory and time grow with
 * the attempt number when a task is killed for memory/time (exit 137 = SIGKILL
 * / OOM, 140 = SLURM time or memory limit), up to maxRetries.
 */

process {
    cpus = 1
    memory = { 4.GB * task.attempt }
    time = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries = 2

    withLabel: process_single {
        cpus = 1
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withLabel: process_low {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withLabel: process_medium {
        cpus = 4
        memory = { 8.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    // BLAT scatter (RELOCATE3_TE_SEARCH_CHUNK): blat_chunks_per_task chunk
    // FASTAs, 4 BLATs at once. Each BLAT holds one 200,000-read chunk and the
    // TE library's index (well under 1 GB), so 4 GB covers 4 of them; the
    // memory and time of process_medium (8 GB, 12 h) would only make the many
    // small jobs wait longer in the queue.
    withLabel: process_blat_chunk {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    // TE search: the 30x peak is 3.4 GB after chunked trimming.
    withLabel: process_high {
        cpus = 8
        memory = { 8.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
}
