// RELOCATE3_TE_SEARCH_CHUNK (relocaTE3 te-search-chunk): stub run, declared outputs only.

nextflow_process {

    name "RELOCATE3_TE_SEARCH_CHUNK"
    script "../main.nf"
    process "RELOCATE3_TE_SEARCH_CHUNK"
    tag "modules"
    tag "relocate3_te_search_chunk"

    test("stub: one chunk BAM per chunk FASTA") {
        options "-stub"

        when {
            process {
                """
                def dir = new File("${outputDir}/inputs"); dir.mkdirs()
                def manifest = new File(dir, 'manifest.tsv'); manifest.text = ''
                def fas = ['chunk.chr3.left.00000.fa', 'chunk.chr3.right.00000.fa'].collect { n -> def f = new File(dir, n); f.text = ''; file(f.absolutePath) }
                input[0] = [ [ id:'chr3' ], file(manifest.absolutePath), fas ]
                input[1] = file("${baseDir}/tests/data/TE_lib/RiceTE.fa")
                """
            }
        }

        then {
            assert process.success
            assert process.out.bams[0][1].collect { p -> new File(p).name }.sort() == [ 'chunk.chr3.left.00000.bam', 'chunk.chr3.right.00000.bam' ]
            assert process.out.versions.size() == 1
        }
    }
}
