// Pipeline-level tests for main.nf (parameter and sample-sheet validation).
//
// nf-test runs Nextflow from .nf-test/tests/<hash>/, and nf-schema resolves
// relative paths in a sample sheet against the launch directory. Each test
// writes its own sheet with absolute read paths (the test profile's
// tests/data/samplesheet_chr3.csv uses ${params.test_data}, conf/test.config).

nextflow_pipeline {

    name "RelocaTE3 pipeline"
    script "../main.nf"
    profile "test,pixi"

    test("rejects a fixed --tsd motif and names the only accepted mode") {
        tag "validation"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
                tsd    = "TTA"
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join("\n")
            assert workflow.failed
            assert log.contains("tsd")
            assert log.contains("UNK")
            assert workflow.trace.tasks().size() == 0
        }
    }

    // Sample names reach task scripts, output file names and publish paths, so
    // only [A-Za-z0-9._-] (starting alphanumeric) is accepted.
    ['x;touch_PWNED', 'a/b', 'a*', '-a'].each { bad ->
        test("rejects the sample name '${bad}' before any task runs") {
            tag "validation"
            options "-stub"

            when {
                def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
                def sheet = new File("${outputDir}/samplesheet_bad_name.csv")
                sheet.parentFile.mkdirs()
                sheet.text = "sample,fastq_1,fastq_2\n${bad},${reads}_1.fq.gz,${reads}_2.fq.gz\n"
                params {
                    input  = sheet.absolutePath
                    outdir = "${outputDir}/results"
                }
            }

            then {
                def log = (workflow.stdout + workflow.stderr).join("\n")
                assert workflow.failed
                assert log.contains("Sample name")
                assert log.contains("A-Za-z0-9")
                assert workflow.trace.tasks().size() == 0
                assert !new File("${launchDir}/PWNED").exists()
                assert !new File("${launchDir}/touch_PWNED").exists()
            }
        }
    }

    // cohort/, multiqc/ and pipeline_info/ sit beside the sample directories
    // under --outdir, so those names are reserved.
    ['cohort', 'multiqc', 'pipeline_info'].each { reserved ->
        test("rejects the reserved sample name '${reserved}' before any task runs") {
            tag "validation"
            options "-stub"

            when {
                def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
                def sheet = new File("${outputDir}/samplesheet_reserved.csv")
                sheet.parentFile.mkdirs()
                sheet.text = "sample,fastq_1,fastq_2\n${reserved},${reads}_1.fq.gz,${reads}_2.fq.gz\n"
                params {
                    input  = sheet.absolutePath
                    outdir = "${outputDir}/results"
                }
            }

            then {
                def log = (workflow.stdout + workflow.stderr).join("\n")
                assert workflow.failed
                assert log.contains("Sample name")
                assert log.contains("reserved")
                assert workflow.trace.tasks().size() == 0
            }
        }
    }

    [te_name: 'a;b', target: 'Chr3;x'].each { param, bad ->
        test("rejects --${param} '${bad}' before any task runs") {
            tag "validation"
            options "-stub"

            when {
                def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
                def sheet = new File("${outputDir}/samplesheet_chr3.csv")
                sheet.parentFile.mkdirs()
                sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
                params {
                    input  = sheet.absolutePath
                    outdir = "${outputDir}/results"
                }
                params[param] = bad
            }

            then {
                def log = (workflow.stdout + workflow.stderr).join("\n")
                assert workflow.failed
                assert log.contains("--${param}")
                assert workflow.trace.tasks().size() == 0
            }
        }
    }

    test("a contig name is a valid --target") {
        tag "validation"
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3.v1_x-2,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input    = sheet.absolutePath
                outdir   = "${outputDir}/results"
                target   = "Chr3"
                genotype = false
            }
        }

        then {
            assert workflow.success
            assert new File("${outputDir}/results/chr3.v1_x-2/results/Chr3.repeat.all_nonref_insert.txt").exists()
        }
    }

    // Nextflow opens the report, timeline, trace and DAG files before
    // validation, so without --outdir they used to land in ./null/pipeline_info.
    test("a missing --outdir fails validation and writes no null/ directory") {
        tag "validation"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input  = sheet.absolutePath
                outdir = null
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join("\n")
            assert workflow.failed
            assert log.contains("outdir")
            assert workflow.trace.tasks().size() == 0
            assert !new File("${launchDir}/null").exists()
        }
    }

    test("a missing sample sheet fails validation before any task runs") {
        tag "validation"

        when {
            params {
                input  = "missing.csv"
                outdir = "${outputDir}/results"
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join("\n")
            assert workflow.failed
            assert log.contains("missing.csv")
            assert log.contains("does not exist")
            assert workflow.trace.tasks().size() == 0
        }
    }

    // Stub runs: every process runs its stub; the assertions count tasks per
    // process (the simple name after the last ':' of the task name).
    test("test profile runs end to end in stub mode") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_INDEX_GENOME') == 1
            assert n('CAT_FASTQ') == 0
            // BLAT TE search scattered (te_aligner blat, blat_scatter): the stub
            // split writes 3 chunks per side; 6 <= blat_chunks_per_task (8).
            assert n('RELOCATE3_TE_SEARCH') == 0
            ['RELOCATE3_TE_SPLIT', 'RELOCATE3_TE_SEARCH_CHUNK', 'RELOCATE3_TE_MERGE_TRIM',
             'RELOCATE3_ALIGN_GENOME', 'RELOCATE3_FIND_INSERTIONS', 'RELOCATE3_FIND_REFERENCE',
             'RELOCATE3_ALIGN_READS', 'RELOCATE3_CHARACTERIZE', 'RELOCATE3_SAMPLE_STATS'].each { p -> assert n(p) == 1 : p }
            // Once per run, after every sample.
            assert n('RELOCATE3_COHORT') == 1
            assert n('MULTIQC') == 1
            // Published: the sample's run-all layout, the cohort, the report and pipeline_info only.
            def out = new File("${outputDir}/results")
            assert out.list().toList().sort() == ['chr3', 'cohort', 'multiqc', 'pipeline_info']
            assert new File(out, 'cohort').list().toList().sort() == ['cohort.characTErized.txt', 'cohort.genotype_matrix.tsv', 'cohort.summary_mqc.tsv']
            assert new File(out, 'multiqc').list().toList().sort() == ['relocate3_report.html', 'relocate3_report_data']
            def published = []
            new File(out, 'chr3').eachFileRecurse(groovy.io.FileType.FILES) { f -> published << out.toPath().resolve('chr3').relativize(f.toPath()).toString() }
            assert published.sort() == [
                'chr3.left.bam', 'chr3.left.bam.bai', 'chr3.repeat.bwaaln.sorted.bam', 'chr3.repeat.bwaaln.sorted.bam.bai',
                'chr3.right.bam', 'chr3.right.bam.bai', 'existingTE.bed',
                'flanking/chr3.left.flankingReads.fq', 'flanking/chr3.right.flankingReads.fq',
                'genome_aln/chr3.fullreads.genome.bam', 'genome_aln/chr3.fullreads.genome.bam.bai',
                'genome_aln/chr3.reads.genome.bam', 'genome_aln/chr3.reads.genome.bam.bai',
                'results/ALL.repeat.all_nonref_insert.all.gff', 'results/ALL.repeat.all_nonref_insert.all.txt',
                'results/ALL.repeat.all_nonref_insert.characTErized.gff', 'results/ALL.repeat.all_nonref_insert.characTErized.txt',
                'results/ALL.repeat.all_nonref_insert.gff', 'results/ALL.repeat.all_nonref_insert.high_conf.gff',
                'results/ALL.repeat.all_nonref_insert.high_conf.txt', 'results/ALL.repeat.all_nonref_insert.raw.gff',
                'results/ALL.repeat.all_nonref_insert.raw.txt', 'results/ALL.repeat.all_nonref_insert.txt',
                'results/ALL.repeat.all_nonref_supporting.gff', 'results/ALL.repeat.all_nonref_supporting.txt',
                'results/chr3.all_ref_insert.gff', 'results/chr3.all_ref_insert.txt',
                'te_containing/chr3.left.ContainingReads.fq', 'te_containing/chr3.read_repeat_name.txt',
                'te_containing/chr3.right.ContainingReads.fq', 'te_containing/chr3.te_hit_names.txt',
                'te_portions/chr3.five_prime.fa', 'te_portions/chr3.three_prime.fa',
            ].sort()
            def versions = new File(out, 'pipeline_info/software_versions.yml').text
            // One entry per process (deduplicated across samples), and the workflow's.
            assert versions.readLines().count { l -> l.startsWith('"') } == 12
            assert versions.readLines().contains('Workflow:')
            assert versions.contains('stajichlab/RelocaTE3: ')
        }
    }

    test("lanes of one sample are merged once; one task per sample per step") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_lanes.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\n" +
                "a,${reads}_1.fq.gz,${reads}_2.fq.gz\n" +
                "b,${reads}_1.fq.gz,${reads}_2.fq.gz\n" +
                "a,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_INDEX_GENOME') == 1
            assert n('CAT_FASTQ') == 1
            ['RELOCATE3_TE_SPLIT', 'RELOCATE3_TE_SEARCH_CHUNK', 'RELOCATE3_TE_MERGE_TRIM',
             'RELOCATE3_ALIGN_GENOME', 'RELOCATE3_FIND_INSERTIONS', 'RELOCATE3_FIND_REFERENCE',
             'RELOCATE3_ALIGN_READS', 'RELOCATE3_CHARACTERIZE', 'RELOCATE3_SAMPLE_STATS'].each { p -> assert n(p) == 2 : p }
            assert n('RELOCATE3_COHORT') == 1
            assert n('MULTIQC') == 1
            def out = new File("${outputDir}/results")
            assert out.list().toList().sort() == ['a', 'b', 'cohort', 'multiqc', 'pipeline_info']
        }
    }

    test("--genotype false runs neither ALIGN_READS nor CHARACTERIZE") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input    = sheet.absolutePath
                outdir   = "${outputDir}/results"
                genotype = false
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_ALIGN_READS') == 0
            assert n('RELOCATE3_CHARACTERIZE') == 0
            // Nothing characterized: no cohort; the report still has the per-sample counts.
            assert n('RELOCATE3_COHORT') == 0
            ['RELOCATE3_INDEX_GENOME', 'RELOCATE3_TE_MERGE_TRIM', 'RELOCATE3_ALIGN_GENOME', 'RELOCATE3_FIND_INSERTIONS',
             'RELOCATE3_FIND_REFERENCE', 'RELOCATE3_SAMPLE_STATS', 'MULTIQC'].each { p -> assert n(p) == 1 : p }
            assert !new File("${outputDir}/results/cohort").exists()
        }
    }

    test("--skip_multiqc runs neither SAMPLE_STATS nor MULTIQC; the cohort is still written") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input        = sheet.absolutePath
                outdir       = "${outputDir}/results"
                skip_multiqc = true
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('MULTIQC') == 0
            assert n('RELOCATE3_SAMPLE_STATS') == 0
            assert n('RELOCATE3_COHORT') == 1
            assert new File("${outputDir}/results").list().toList().sort() == ['chr3', 'cohort', 'pipeline_info']
        }
    }

    test("without --repeatmasker FIND_REFERENCE does not run") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input        = sheet.absolutePath
                outdir       = "${outputDir}/results"
                repeatmasker = null
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_FIND_REFERENCE') == 0
            ['RELOCATE3_INDEX_GENOME', 'RELOCATE3_TE_MERGE_TRIM', 'RELOCATE3_ALIGN_GENOME', 'RELOCATE3_FIND_INSERTIONS',
             'RELOCATE3_ALIGN_READS', 'RELOCATE3_CHARACTERIZE'].each { p -> assert n(p) == 1 : p }
        }
    }

    test("a sample with genotype_bam skips ALIGN_READS and is characterized") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def dir = new File("${outputDir}/inputs"); dir.mkdirs()
            def bam = new File(dir, 'given.bam'); bam.text = ''
            new File(dir, 'given.bam.bai').text = ''
            def sheet = new File(dir, 'samplesheet_bam.csv')
            sheet.text = "sample,fastq_1,fastq_2,genotype_bam\n" +
                "given,${reads}_1.fq.gz,${reads}_2.fq.gz,${bam.absolutePath}\n" +
                "aligned,${reads}_1.fq.gz,${reads}_2.fq.gz,\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_ALIGN_READS') == 1
            assert n('RELOCATE3_CHARACTERIZE') == 2
            def given = workflow.trace.tasks().find { t -> t.name.startsWith('RELOCATE3:ONE_SAMPLE:RELOCATE3_ALIGN_READS') }
            assert given.name.contains('(aligned)')
            // The given BAM is an input, so it is not published; no reads BAM is made.
            def given_files = []
            new File("${outputDir}/results/given").eachFileRecurse(groovy.io.FileType.FILES) { f -> given_files << f.name }
            assert !given_files.any { f -> f.startsWith('given.bam') || f.startsWith('given.reads.genome.bam') }
            assert given_files.contains('ALL.repeat.all_nonref_insert.characTErized.txt')
            assert new File("${outputDir}/results/aligned/genome_aln/aligned.reads.genome.bam").exists()
        }
    }

    // run-all genotypes whenever --genotype-bam is given (`--genotype or
    // --genotype-bam`); --genotype only decides whether reads are aligned.
    test("--genotype false still characterizes a sample with a genotype_bam") {
        options "-stub"
        tag "genotype"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def dir = new File("${outputDir}/inputs"); dir.mkdirs()
            def bam = new File(dir, 'given.bam'); bam.text = ''
            new File(dir, 'given.bam.bai').text = ''
            def sheet = new File(dir, 'samplesheet_bam.csv')
            sheet.text = "sample,fastq_1,fastq_2,genotype_bam\n" +
                "given,${reads}_1.fq.gz,${reads}_2.fq.gz,${bam.absolutePath}\n" +
                "plain,${reads}_1.fq.gz,${reads}_2.fq.gz,\n"
            params {
                input    = sheet.absolutePath
                outdir   = "${outputDir}/results"
                genotype = false
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_ALIGN_READS') == 0
            assert n('RELOCATE3_CHARACTERIZE') == 1
            // One sample characterized is enough for the cohort.
            assert n('RELOCATE3_COHORT') == 1
            def characterized = workflow.trace.tasks().find { t -> t.name.startsWith('RELOCATE3:ONE_SAMPLE:RELOCATE3_CHARACTERIZE') }
            assert characterized.name.contains('(given)')
            // The cohort's input is the given sample's table only.
            def cohortRow = new File("${launchDir}/meta/trace.csv").readLines().drop(1)
                .collect { line -> line.split('\t') }
                .find { f -> f[3].tokenize(' ')[0].tokenize(':')[-1] == 'RELOCATE3_COHORT' }
            def (cdir, cprefix) = cohortRow[1].tokenize('/')
            def cwork = new File("${launchDir}/work/${cdir}").listFiles().find { d -> d.name.startsWith(cprefix) }
            def staged = []
            new File(cwork, 'tables').eachFileRecurse(groovy.io.FileType.ANY) { f -> if (!f.isDirectory()) staged << f }
            assert staged.size() == 1
            // (stub mode: .command.sh is the stub, which names its inputs)
            def cmd = new File(cwork, '.command.sh').text
            assert cmd.contains('given=tables/1/ALL.repeat.all_nonref_insert.characTErized.txt')
            assert !cmd.contains('plain=')
            assert new File("${outputDir}/results/given/results/ALL.repeat.all_nonref_insert.characTErized.txt").exists()
            assert !new File("${outputDir}/results/plain/results/ALL.repeat.all_nonref_insert.characTErized.txt").exists()
        }
    }

    test("a genotype_bam without its index fails before characterization") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def dir = new File("${outputDir}/inputs"); dir.mkdirs()
            def bam = new File(dir, 'noindex.bam'); bam.text = ''
            def sheet = new File(dir, 'samplesheet_bam.csv')
            sheet.text = "sample,fastq_1,fastq_2,genotype_bam\ngiven,${reads}_1.fq.gz,${reads}_2.fq.gz,${bam.absolutePath}\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join("\n")
            assert workflow.failed
            assert log.contains('noindex.bam.bai')
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("lanes of one sample that disagree on paired-end are rejected") {
        options "-stub"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_mixed.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\n" +
                "a,${reads}_1.fq.gz,${reads}_2.fq.gz\n" +
                "a,${reads}_1.fq.gz,\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
            }
        }

        then {
            def log = (workflow.stdout + workflow.stderr).join("\n")
            assert workflow.failed
            assert log.contains("Sample 'a'")
            assert log.contains('single-end')
            assert workflow.trace.tasks().size() == 0
        }
    }

    // A real run (stub mode would put the stub: block in .command.sh) with a
    // distinct, non-default value for every calling setting; each value must
    // follow its own flag in the right task's .command.sh. Option strings with
    // single quotes must survive the shell quoting of --te-opts/--genome-opts
    // (their values equal the aligners' defaults, so calls are unaffected).
    test("every setting reaches its flag in the right task") {
        tag "params"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input                  = sheet.absolutePath
                outdir                 = "${outputDir}/results"
                mismatch               = 3
                min_match              = 11
                min_trimmed            = 12
                size                   = 501
                min_mapq               = 1
                distance               = 4
                tsd                    = "UKN"
                target                 = "Chr3"
                te_name                = "other"
                require_both_junctions = false
                te_opts                = "-minScore='10' -tileSize=7"
                genome_opts            = "-n '0.04' -o 1"
                bcftools               = "bcftools-custom"
            }
        }

        then {
            assert workflow.success
            // simple process name -> .command.sh text, from the run's trace
            def scripts = [:]
            new File("${launchDir}/meta/trace.csv").readLines().drop(1).each { line ->
                def f = line.split('\t')
                def proc = f[3].tokenize(' ')[0].tokenize(':')[-1]
                def (dir, prefix) = f[1].tokenize('/')
                def work = new File("${launchDir}/work/${dir}").listFiles().find { d -> d.name.startsWith(prefix) }
                scripts[proc] = new File(work, '.command.sh').text
            }
            def expected = [
                RELOCATE3_INDEX_GENOME   : ['--genome-aligner bwaaln'],
                RELOCATE3_TE_SPLIT       : ['--chunk-reads 200000'],
                RELOCATE3_TE_SEARCH_CHUNK: ["--te-opts='-minScore='\\''10'\\'' -tileSize=7'"],
                RELOCATE3_TE_MERGE_TRIM  : ['--min-match 11', '--min-trimmed 12', '--mismatch 3'],
                RELOCATE3_ALIGN_GENOME   : ['--genome-aligner bwaaln', "--genome-opts='-n '\\''0.04'\\'' -o 1'"],
                RELOCATE3_FIND_INSERTIONS: ['--tsd UKN', '--target Chr3', '--te-name other', '--mismatch 3', '--min-mapq 1',
                                            '--no-require-both-junctions', '--size 501', '--distance 4',
                                            '--reference-ins MSU7.Chr3_2M.fa.RepeatMasker.out'],
                RELOCATE3_CHARACTERIZE   : ['-s results/Chr3.other.all_nonref_insert.txt', '--bcftools bcftools-custom'],
                RELOCATE3_SAMPLE_STATS   : ['-n chr3', '--target Chr3', '--te-name other'],
            ]
            expected.each { proc, args ->
                assert scripts.containsKey(proc) : proc
                def words = scripts[proc].replaceAll(/\\\n/, ' ').replaceAll(/\s+/, ' ')
                args.each { a -> assert (" ${words} ").contains(" ${a} ") : "${proc}: ${a}" }
            }
            // The shell hands relocaTE3 the option strings unchanged.
            [RELOCATE3_TE_SEARCH_CHUNK: ['--te-opts', "-minScore='10' -tileSize=7"],
             RELOCATE3_ALIGN_GENOME: ['--genome-opts', "-n '0.04' -o 1"]].each { proc, flag_value ->
                def (flag, value) = flag_value
                def word = (scripts[proc] =~ /${flag}='(?:[^']|'\\'')*'/)[0]
                def argv = ['bash', '-c', "printf %s ${word}"].execute().text
                assert argv == "${flag}=${value}"
            }
            assert !scripts['RELOCATE3_CHARACTERIZE'].contains('--excision')
            assert new File("${outputDir}/results/chr3/results/Chr3.other.all_nonref_insert.characTErized.txt").exists()
        }
    }

    // A real run with the test profile's settings (those of the parity gate),
    // on the Chr3 reads under two sample names: the cohort table is both
    // samples' characterized rows unchanged (by sample, then row order), the
    // matrix has a column per sample, and the MultiQC report has the cohort,
    // per-sample and software-version sections.
    test("real run, two samples: cohort rows equal the per-sample tables; MultiQC report") {
        tag "report"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\n" +
                "chr3b,${reads}_1.fq.gz,${reads}_2.fq.gz\n" +
                "chr3a,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input  = sheet.absolutePath
                outdir = "${outputDir}/results"
            }
        }

        then {
            assert workflow.success
            def out = new File("${outputDir}/results")
            def table = { String s -> new File(out, "${s}/results/ALL.repeat.all_nonref_insert.characTErized.txt").readLines() }
            def a = table('chr3a')
            def b = table('chr3b')
            assert a.size() == 197 && b.size() == 197
            assert a[0] == b[0]
            def cohort = new File(out, 'cohort/cohort.characTErized.txt').readLines()
            assert cohort == [a[0]] + a.drop(1) + b.drop(1)
            assert cohort.drop(1).collect { l -> l.tokenize('\t')[0] }.unique() == ['chr3a', 'chr3b']
            def matrix = new File(out, 'cohort/cohort.genotype_matrix.tsv').readLines()
            assert matrix[0] == 'chromosome\tstart\tend\tstrand\tTE\tchr3a\tchr3b'
            assert matrix.size() == a.size()
            // the same reads give the same call at every site
            assert matrix.drop(1).every { l -> def f = l.split('\t'); f[5] == f[6] && f[5] != '.' }
            def summary = new File(out, 'cohort/cohort.summary_mqc.tsv').readLines().findAll { l -> !l.startsWith('#') }
            assert summary[1].startsWith("chr3a\t${a.size() - 1}\t")
            assert summary[2].startsWith("chr3b\t${b.size() - 1}\t")

            assert new File(out, 'multiqc/relocate3_report.html').size() > 0
            def data_dir = new File(out, 'multiqc/relocate3_report_data')
            def json = new File(data_dir, 'multiqc_data.json').text
            assert json.contains('relocate3_cohort_summary')
            def data = new groovy.json.JsonSlurper().parseText(json)
            assert data.config_title == 'RelocaTE3'
            assert data.config_report_comment.contains('stajichlab/RelocaTE3 ')
            def stats = data.report_saved_raw_data.multiqc_relocate3_sample_stats_table
            assert stats.keySet() == ['chr3a', 'chr3b'] as Set
            assert stats.chr3a.characterized == a.size() - 1
            assert stats.chr3a.nonref_raw == new File(out, 'chr3a/results/ALL.repeat.all_nonref_insert.raw.txt').readLines().size()
            def versions = new File(data_dir, 'multiqc_software_versions.txt').readLines()
            assert versions.any { l -> l.startsWith('RELOCATE3_TE_MERGE_TRIM\t') }
            assert versions.any { l -> l.startsWith('Workflow\t') }
        }
    }

    // ---------------------------------------------------------- BLAT scatter
    // te_aligner blat + blat_scatter (default): TE_SPLIT -> TE_SEARCH_CHUNK
    // (sorted chunk FASTAs of a sample, both sides, in groups of
    // blat_chunks_per_task) -> TE_MERGE_TRIM once per sample. The stub split
    // writes 3 chunks per side.

    test("BLAT scatter: sorted chunk groups of blat_chunks_per_task; one merge per sample") {
        options "-stub"
        tag "scatter"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_scatter.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\n" +
                "pe,${reads}_1.fq.gz,${reads}_2.fq.gz\n" +
                "se,${reads}_1.fq.gz,\n"
            params {
                input                = sheet.absolutePath
                outdir               = "${outputDir}/results"
                blat_chunks_per_task = 4
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_TE_SEARCH') == 0
            assert n('RELOCATE3_TE_SPLIT') == 2
            // pe: ceil(6 / 4) = 2; se: ceil(3 / 4) = 1
            assert n('RELOCATE3_TE_SEARCH_CHUNK') == 3
            assert n('RELOCATE3_TE_MERGE_TRIM') == 2
            // staged file names per task: [ process, sample ] -> [ names ]
            def staged = [:].withDefault { [] }
            new File("${launchDir}/meta/trace.csv").readLines().drop(1).each { line ->
                def f = line.split('\t')
                def proc = f[3].tokenize(' ')[0].tokenize(':')[-1]
                def tag = f[3] =~ /\((.+)\)/
                if (!tag.find()) return
                def sample = tag.group(1)
                def (dir, prefix) = f[1].tokenize('/')
                def work = new File("${launchDir}/work/${dir}").listFiles().find { d -> d.name.startsWith(prefix) }
                staged[[proc, sample]] << work.list().findAll { x -> x.startsWith('chunk.') || x == 'manifest.tsv' }.sort()
            }
            def chunk = { String s, String side, int i -> "chunk.${s}.${side}.0000${i}" }
            assert staged[['RELOCATE3_TE_SEARCH_CHUNK', 'pe']].collect { l -> l.findAll { x -> x.endsWith('.fa') } } as Set == [
                [ chunk('pe', 'left', 0), chunk('pe', 'left', 1), chunk('pe', 'left', 2), chunk('pe', 'right', 0) ].collect { c -> c + '.fa' },
                [ chunk('pe', 'right', 1), chunk('pe', 'right', 2) ].collect { c -> c + '.fa' },
            ] as Set
            assert staged[['RELOCATE3_TE_SEARCH_CHUNK', 'pe']].every { l -> l.contains('manifest.tsv') }
            assert staged[['RELOCATE3_TE_SEARCH_CHUNK', 'se']].collect { l -> l.findAll { x -> x.endsWith('.fa') } } == [
                (0..2).collect { i -> chunk('se', 'left', i) + '.fa' },
            ]
            // the merge gets every chunk BAM of its sample (and the manifest)
            def merged = { String s -> staged[['RELOCATE3_TE_MERGE_TRIM', s]][0].findAll { x -> x.endsWith('.bam') } }
            assert merged('pe') == ['left', 'right'].collectMany { side -> (0..2).collect { i -> chunk('pe', side, i) + '.bam' } }
            assert merged('se') == (0..2).collect { i -> chunk('se', 'left', i) + '.bam' }
            assert staged[['RELOCATE3_TE_MERGE_TRIM', 'pe']][0].contains('manifest.tsv')
            // no chunk file is published
            def published = []
            new File("${outputDir}/results").eachFileRecurse(groovy.io.FileType.FILES) { f -> published << f.name }
            assert !published.any { f -> f.startsWith('chunk.') || f == 'manifest.tsv' }
            assert new File("${outputDir}/results/se/te_containing/se.read_repeat_name.txt").exists()
        }
    }

    test("BLAT scatter: blat_chunks_per_task 1 searches each chunk in its own task") {
        options "-stub"
        tag "scatter"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input                = sheet.absolutePath
                outdir               = "${outputDir}/results"
                blat_chunks_per_task = 1
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            assert n('RELOCATE3_TE_SPLIT') == 1
            assert n('RELOCATE3_TE_SEARCH_CHUNK') == 6
            assert n('RELOCATE3_TE_MERGE_TRIM') == 1
            assert n('RELOCATE3_CHARACTERIZE') == 1
        }
    }

    [[blat_scatter: false], [te_aligner: 'minimap2'], [te_aligner: 'bwaaln']].each { setting ->
        test("${setting}: one TE_SEARCH task, no scatter; the same published files") {
            options "-stub"
            tag "scatter"

            when {
                def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
                def sheet = new File("${outputDir}/samplesheet_chr3.csv")
                sheet.parentFile.mkdirs()
                sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
                params {
                    input  = sheet.absolutePath
                    outdir = "${outputDir}/results"
                }
                setting.each { k, v -> params[k] = v }
            }

            then {
                def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
                assert workflow.success
                assert n('RELOCATE3_TE_SEARCH') == 1
                ['RELOCATE3_TE_SPLIT', 'RELOCATE3_TE_SEARCH_CHUNK', 'RELOCATE3_TE_MERGE_TRIM'].each { p -> assert n(p) == 0 : p }
                assert n('RELOCATE3_CHARACTERIZE') == 1
                def out = new File("${outputDir}/results/chr3")
                def published = []
                out.eachFileRecurse(groovy.io.FileType.FILES) { f -> published << out.toPath().relativize(f.toPath()).toString() }
                assert published.size() == 33
                assert published.contains('te_containing/chr3.read_repeat_name.txt')
            }
        }
    }

    // A real run with small chunks, so the Chr3 reads are split into many
    // chunks and searched in several tasks; its TE-search outputs must equal
    // one unsplit `relocaTE3 run` on the same reads (text byte for byte, BAMs
    // record by record: validation/blat_memory/compare_outputs.sh). The full
    // per-sample equality with run-all is the parity gate
    // (NXF_EXTRA_PARAMS=... tests/nextflow/parity_chr3.sh).
    test("real run, forced scatter: TE-search outputs equal one unsplit relocaTE3 run") {
        tag "scatter"
        tag "scatter_real"

        when {
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def sheet = new File("${outputDir}/samplesheet_chr3.csv")
            sheet.parentFile.mkdirs()
            sheet.text = "sample,fastq_1,fastq_2\nchr3,${reads}_1.fq.gz,${reads}_2.fq.gz\n"
            params {
                input                = sheet.absolutePath
                outdir               = "${outputDir}/results"
                blat_chunk_reads     = 5000
                blat_chunks_per_task = 3
                genotype             = false
                skip_multiqc         = true
            }
        }

        then {
            def n = { String p -> workflow.trace.tasks().count { t -> t.name.tokenize(' ')[0].tokenize(':')[-1] == p } }
            assert workflow.success
            // chunks per the split's manifest; groups of 3 across both sides
            def splitRow = new File("${launchDir}/meta/trace.csv").readLines().drop(1)
                .collect { line -> line.split('\t') }
                .find { f -> f[3].tokenize(' ')[0].tokenize(':')[-1] == 'RELOCATE3_TE_SPLIT' }
            def (sdir, sprefix) = splitRow[1].tokenize('/')
            def swork = new File("${launchDir}/work/${sdir}").listFiles().find { d -> d.name.startsWith(sprefix) }
            def chunks = new File(swork, 'chr3.te_chunks/manifest.tsv').readLines().drop(1).findAll { l -> l }
            assert chunks.size() > 6
            assert n('RELOCATE3_TE_SEARCH_CHUNK') == (int) Math.ceil(chunks.size() / 3.0)
            assert n('RELOCATE3_TE_MERGE_TRIM') == 1

            def bin = "${baseDir}/.pixi/envs/pipeline/bin"
            def base = "${outputDir}/compare"
            def reads = "${baseDir}/tests/data/sim_reads/MSU7.Chr3_2M.ALL_reads_6X_100_500"
            def script = """
                set -euo pipefail
                export PATH='${bin}':"\$PATH" TMPDIR='${base}/tmp'
                mkdir -p '${base}/tmp' '${base}/te' '${base}/scatter'
                cp '${baseDir}/tests/data/TE_lib/RiceTE.fa' '${base}/te/'
                relocaTE3 run --left '${reads}_1.fq.gz' --right '${reads}_2.fq.gz' \\
                    --te-library '${base}/te/RiceTE.fa' --name chr3 --outdir '${base}/unsplit' --threads 2
                cd '${outputDir}/results/chr3'
                cp -r --parents chr3.left.bam chr3.right.bam te_containing flanking te_portions '${base}/scatter/'
                PIXI_BIN='${bin}' bash '${baseDir}/validation/blat_memory/compare_outputs.sh' '${base}/unsplit' '${base}/scatter'
            """
            def proc = ['bash', '-c', script].execute()
            def stdout = new StringBuffer(), stderr = new StringBuffer()
            proc.consumeProcessOutput(stdout, stderr)
            proc.waitFor()
            assert proc.exitValue() == 0 : "${stdout}\n${stderr}"
            assert stdout.toString().contains('identical=10 differing=0') : stdout
        }
    }
}
